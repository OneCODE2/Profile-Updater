{
  "manifest_version": 3,
  "name": "Naukri Profile Updater",
  "version": "1.0.0",
  "description": "Local-only Naukri profile updater. Schedule stays off until you turn it on.",
  "minimum_chrome_version": "148",
  "message_serialization": "structured_clone",
  "incognito": "not_allowed",
  "action": {
    "default_title": "Naukri Profile Updater",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms", "scripting", "notifications", "tabs"],
  "host_permissions": ["https://www.naukri.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'"
  }
}
