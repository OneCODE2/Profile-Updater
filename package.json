{
  "name": "naukari-profile-updater",
  "version": "1.0.0",
  "description": "Naukri profile updater — Electron desktop + web deploy (Render + Supabase)",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "start:bg": "electron . --background",
    "start:web": "node server/index.js",
    "build": "node scripts/install-browsers.js",
    "test": "node --test test/*.test.js",
    "build:extension": "node scripts/build-extension.js"
  },
  "keywords": [
    "naukri",
    "electron",
    "playwright",
    "render",
    "supabase"
  ],
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "playwright": "^1.65.1",
    "playwright-core": "^1.61.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "electron": "^33.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron"]
  }
}
